#pragma kernel CSProbabilityMain
#pragma kernel CSPotentialPathMain

StructuredBuffer<uint> obstaclePos;
StructuredBuffer<float3> startPosBuffer;
RWStructuredBuffer<uint> pathStepsBuffer;
RWStructuredBuffer<float3> probGrid;
RWStructuredBuffer<float3> pathBuffer;

bool isMAPF;
uint xMax;
uint yMax;
uint zMax;
uint numObs;
uint numAgents;
uint maxSteps;
float D;
float dIO; //distance of influence for obstacles
float kAttractive;
float kRepulsive;
float minGradient;
float cellStepSize;
float minGoalDistance;
float3 cellSize;
float3 gridStart;
float3 qGoal;

uint3 GetGridPos(uint cellIndex) {
    uint3 g;
    g.x = cellIndex % xMax;
    g.y = (cellIndex / xMax) % yMax;
    g.z = cellIndex / (xMax * yMax);
    return g;
}

uint GetGridIndex(uint3 gridPos) {
    return gridPos.x + gridPos.y * xMax + gridPos.z * xMax * yMax;
}

uint CoordToIndex(float3 coord) {
    uint3 local = (uint3)floor((coord - gridStart) / cellSize);
    uint coordIndex = local.x + local.y * xMax + local.z * xMax * yMax;
    return coordIndex;
}

float3 IndexToCoordinate(uint cellIndex) {
    uint3 g = GetGridPos(cellIndex);
    return gridStart + float3(g.x, g.y, g.z) * cellSize;
}

[numthreads(1024, 1, 1)]
void CSProbabilityMain (uint3 id : SV_DispatchThreadID) {
    uint cellIndex = id.x;
    if (cellIndex >= (xMax * yMax * zMax)) return;
    float3 currentPos = IndexToCoordinate(cellIndex);

    //Calculate the force of the potential field at the current
    //grid position
    float3 attractiveForce;
    if (isMAPF) {
        attractiveForce = (
            (-1 * kAttractive) * 
            (
                distance(currentPos, qGoal) + 
                pow((1/(D + distance(currentPos, qGoal))), 3)
            ) * 
            ((currentPos - qGoal)/distance(currentPos, qGoal))
        );
    }
    else {
        attractiveForce = (
            (-1 * kAttractive) * (currentPos - qGoal)
        );
    }
    
    float3 repulsiveForce = 0;
    for (uint i = 0; i < numObs; i++) {
        float3 qObs = IndexToCoordinate(obstaclePos[i]);
        float dQI = distance(currentPos, qObs);
        if (dQI < dIO && dQI > 0.0001) {
            repulsiveForce += (
                kRepulsive * (currentPos - qObs) / pow(dQI, 3)
                * ((1 / dQI) - (1 / dIO))
            );
        }
    }
    float3 totalForce = attractiveForce + repulsiveForce;
    probGrid[cellIndex] = totalForce;
}

[numthreads(64, 1, 1)]
void CSPotentialPathMain (uint3 id : SV_DispatchThreadID) {
    uint agent = id.x;
    if (agent >= numAgents) return;

    float3 currentCoordPos = startPosBuffer[agent];
    uint basePathIndex = agent * maxSteps;

    uint steps = 0;

    for (uint i = 0; i < maxSteps; i++)
    {

        if (distance(currentCoordPos, qGoal) < minGoalDistance)
        {
            break;
        }

        pathBuffer[basePathIndex + i] = currentCoordPos;
        steps++;

        uint cellIndex = CoordToIndex(currentCoordPos);
        float3 F = probGrid[cellIndex];
        float mag = length(F);
        
        if (mag < minGradient)
        {
            float3 newForce = 0;
            for (uint i = 0; i < numObs; i++) {
                float3 qObs = IndexToCoordinate(obstaclePos[i]);
                float dQI = distance(currentCoordPos, qObs);
                if (dQI < dIO && dQI > 0.0001) {
                    newForce -= (
                        kRepulsive * ((currentCoordPos - qObs) / dQI)
                        * (pow((1 / dQI), 2) - pow((1 / dIO), 2))
                    );
                }
            }
            
            uint currentIndexPos = CoordToIndex(currentCoordPos);
            probGrid[currentIndexPos] += newForce;
            F = probGrid[currentIndexPos];
            mag = length(F);
        }

        float3 dir = F / mag;

        currentCoordPos += dir * cellStepSize;

        currentCoordPos = clamp(
            currentCoordPos,
            gridStart,
            gridStart + float3(xMax - 1, yMax - 1, zMax - 1) * cellSize
        );

    }

    pathStepsBuffer[agent] = steps;

}